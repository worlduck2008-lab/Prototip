name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Найти папку проекта
        run: |
          P=$(dirname "$(find . -name package.json -not -path '*/node_modules/*' | head -1)")
          echo "Проект в: $P"
          echo "PROJ=$P" >> $GITHUB_ENV
      - name: Подготовить
        working-directory: ${{ env.PROJ }}
        run: |
          mkdir -p www
          cp index.html www/index.html
          npm install
          npx cap add android
          npx cap sync android
      - name: Собрать APK
        working-directory: ${{ env.PROJ }}/android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: zhdem-mishu-apk
          path: ${{ env.PROJ }}/android/app/build/outputs/apk/debug/app-debug.apk
